<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card">
    <ImageView
        android:id="@+id/imgCartProduct"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_car"
        android:background="@drawable/bg_icon_circle"
        android:padding="10dp"/>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">
        <TextView
            android:id="@+id/tvCartName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ноутбук"
            android:textSize="15dp"
            android:layout_marginTop="8dp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="2"/>
        <TextView
            android:id="@+id/tvCartPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="59 999 руб."
            android:textSize="15dp"
            android:textColor="@color/text_primary"
            android:layout_marginTop="6dp"
            android:maxLines="2"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMinus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:backgroundTint="@color/accent_green_light"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_minus"
                app:iconTint="@color/accent_green_dark"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp" />
            <TextView
                android:id="@+id/tvCount"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:textSize="15sp"
                android:gravity="center"
                android:textColor="@color/text_primary"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:backgroundTint="@color/accent_green_light"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_plus"
                app:iconTint="@color/accent_green_dark"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Удалить"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/accent_green_dark"
                android:layout_marginStart="20dp"
                android:backgroundTint="@color/accent_green_light"
                app:cornerRadius="12dp" />


        </LinearLayout>
    </LinearLayout>


</LinearLayout>